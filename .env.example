# ============================================================================
# alto bundler 环境变量（被 docker-compose.yml 的 ${} 替换进 command 参数）
# 复制为 .env 后填值
# ============================================================================

# ---------------- 链 / RPC ----------------
# RPC URL（chain 信息由 alto 通过 eth_chainId 自动获取，不需要 network-name）
RPC_URL=http://172.31.20.237:8545

# 支持的 EntryPoint（逗号分隔，可同时挂多个版本）
ENTRYPOINTS=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108,0x1581bcE5FC34d62fB8BF240886B9eBdCd20020fd

# ---------------- 钱包 ----------------
# 执行 handleOps 的 EOA 私钥（逗号分隔，多个进钱包池）
# 横扩共享 Redis 后多实例可共用同一组（Redis SPOP 原子领取保证不冲突）
EXECUTOR_PRIVATE_KEYS=0x...,0x...,0x...

# utility 钱包：部署 simulations 合约、给执行钱包 refill
# ⚠️ 建议跟 executor 用独立私钥，避免 nonce 抢占
UTILITY_PRIVATE_KEY=0x...

# 执行钱包余额下限（wei）。0 = 关闭自动 refill（手动维护余额）
# 1 BAC = 1000000000000000000 (1e18)
MIN_EXECUTOR_BALANCE=0

# ---------------- Gas ----------------
# 网络 gas price 上浮百分比（120 = +20% buffer，应对 baseFee 波动）
GAS_PRICE_BUMP=120

# ---------------- Redis（跟 argo 共享的 ElastiCache cluster-mode-enabled） ----------------
# 必须用配置端点 clustercfg.* + rediss:// (TLS) + auth token
# 不要用单节点 endpoint bac-redis-0001-001.*（failover 会变 READONLY）
REDIS_ENDPOINT=rediss://:CHANGE_ME_AUTH_TOKEN@clustercfg.bac-redis.oqnnxv.apse1.cache.amazonaws.com:6379

# true = ioredis Cluster 客户端（ElastiCache cluster-mode-enabled 必须 true）
REDIS_CLUSTER=true

# 跟 argo / 其他项目隔离的 key 前缀
REDIS_KEY_PREFIX=alto-bac

# ---------------- 端口 ----------------
ALTO_HOST_PORT=3011
